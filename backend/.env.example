```env
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-3-flash-preview
GEMINI_ANALYST_MODEL=gemini-3-flash-preview

# ============================================================
# Fact-Checking V2 - Phase 1 -> 3
# ============================================================

# Google Programmable Search JSON API
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Retrieval models
TEXT_RETRIEVAL_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
IMAGE_RETRIEVAL_MODEL=openai/clip-vit-base-patch32

# Retrieval limits
WEB_SEARCH_MAX_RESULTS=10
TEXT_RETRIEVAL_TOP_N=20
IMAGE_RETRIEVAL_TOP_N=10
TEXT_EVIDENCE_TOP_K=5
IMAGE_EVIDENCE_TOP_K=3
MAX_CHECK_WORTHY_CLAIMS=5

# Network safeguards
EVIDENCE_REQUEST_TIMEOUT=10
EVIDENCE_MAX_PAGE_BYTES=2000000
EVIDENCE_MAX_IMAGE_BYTES=8000000

# CoReS-inspired concept filtering
CONCEPT_CLUSTER_THRESHOLD=0.86
CONCEPT_CLAIM_THRESHOLD=0.40
CONCEPT_MIN_FREQ_RATIO=0.20

# Phase 4 - Multimodal Claim Verification
VERIFICATION_MAX_IMAGES=3
VERIFICATION_MAX_EVIDENCE_CHARS=1800
```